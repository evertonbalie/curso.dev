{
  "name": "curso.dev",
  "version": "1.0.0",
  "description": "\"# curso.dev\" \r \"# curso.dev\"",
  "scripts": {
    "test1": "echo \"Error: no test specified\" && exit 1",
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml  stop",
    "services:down": "docker compose -f infra/compose.yaml  down",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "migration:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migration:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "migration:down": "node-pg-migrate --migrations-dir infra/migrations down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evertonbalie/curso.dev.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/evertonbalie/curso.dev/issues"
  },
  "homepage": "https://github.com/evertonbalie/curso.dev#readme",
  "dependencies": {
    "dotenv": "^16.4.4",
    "dotenv-expand": "^11.0.6",
    "next": "^13.1.6",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "jest": "^29.6.2"
  }
}
